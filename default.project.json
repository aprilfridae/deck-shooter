{
  "name": "DeckShooter",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "CardCore": { "$path": "src/shared/CardCore" },
      "Movement": { "$path": "src/shared/Movement" },
      "Guns": { "$path": "src/shared/Guns" },
      "GunModels": { "$path": "assets/models/GunModels.rbxm" }
    },
    "Lighting": {
      "ColorGrading": { "$path": "assets/models/ColorGrading.rbxm" },
      "Bloom": { "$path": "assets/models/Bloom.rbxm" }
    },
    "Workspace": {
      "$properties": { "Gravity": 150, "StreamingEnabled": false }
    },
    "ServerScriptService": {
      "CardCoreServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMode": "LockFirstPerson" },
      "StarterCharacterScripts": {
        "Health": { "$path": "src/character/Health.server.luau" }
      },
      "StarterPlayerScripts": {
        "CardCoreClient": { "$path": "src/client" }
      }
    }
  }
}
