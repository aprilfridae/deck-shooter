{
  "name": "DeckShooter",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "CardCore": { "$path": "src/shared/CardCore" },
      "Movement": { "$path": "src/shared/Movement" },
      "Guns": { "$path": "src/shared/Guns" },
      "GunModels": { "$className": "Folder", "$ignoreUnknownInstances": true }
    },
    "Workspace": {
      "$properties": { "Gravity": 150 }
    },
    "ServerScriptService": {
      "CardCoreServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMode": "LockFirstPerson" },
      "StarterCharacterScripts": {
        "Health": { "$path": "src/character/Health.server.luau" }
      },
      "StarterPlayerScripts": {
        "CardCoreClient": { "$path": "src/client" }
      }
    }
  }
}
