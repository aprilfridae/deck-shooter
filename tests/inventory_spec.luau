local harness = require("./harness")
local Config = require("../src/shared/CardCore/Config")
local Inventory = require("../src/shared/CardCore/Inventory")
local SaveData = require("../src/shared/CardCore/SaveData")

local describe, it, expect = harness.describe, harness.it, harness.expect

describe("Inventory limits", function()
	it("never lets a stack pass the save's limit", function()
		local data = { stacks = {} }
		Inventory.add(data, "overclock", "Field", "Base", Config.MaxStackCount + 5)
		expect(Inventory.count(data, "overclock", "Field", "Base")).toBe(Config.MaxStackCount)
	end)
end)

describe("SaveData.new", function()
	it("starts with no Credits or Catalysts", function()
		local data = SaveData.new()
		expect(data.version).toBe(SaveData.CURRENT_VERSION)
		expect(data.credits).toBe(0)
		expect(data.creditRemainder).toBe(0)
		expect(data.catalysts).toBe(0)
		expect(data.gunLevels).toEqual({ 0, 0 })
	end)

	it("starts with 3 equipped Field starter cards", function()
		local data = SaveData.new()
		expect(data.deck).toEqual({
			{ cardId = "phase_dash", tier = "Field" },
			{ cardId = "overclock", tier = "Field" },
			{ cardId = "recon_pulse", tier = "Field" },
		})
		expect(Inventory.count(data, "phase_dash", "Field")).toBe(1)
		expect(Inventory.count(data, "overclock", "Field", "Base")).toBe(1)
		expect(Inventory.count(data, "recon_pulse", "Field")).toBe(1)
	end)

	it("gives each player separate tables", function()
		local a, b = SaveData.new(), SaveData.new()
		a.deck[1].tier = "Prototype"
		a.stacks.x = 1
		a.gunLevels[1] = 9
		expect(b.deck[1].tier).toBe("Field")
		expect(b.stacks.x).toBeNil()
		expect(b.gunLevels[1]).toBe(0)
	end)
end)

describe("Inventory", function()
	it("round-trips a stack key", function()
		local key = Inventory.key("aegis_shell", "BlackSite", "ZeroDay")
		expect(key).toBe("aegis_shell:BlackSite:ZeroDay")
		local cardId, tier, variant = Inventory.parse(key)
		expect(cardId).toBe("aegis_shell")
		expect(tier).toBe("BlackSite")
		expect(variant).toBe("ZeroDay")
	end)

	it("returns nil when parsing a malformed key", function()
		expect((Inventory.parse("aegis_shell:Field"))).toBeNil()
		expect((Inventory.parse("a:b:c:d"))).toBeNil()
		expect((Inventory.parse(""))).toBeNil()
	end)

	it("never goes negative, and clears empty stacks", function()
		local data = SaveData.new()
		Inventory.add(data, "aegis_shell", "Field", "Base", 2)
		expect(Inventory.remove(data, "aegis_shell", "Field", "Base", 3)).toBe(false)
		expect(Inventory.count(data, "aegis_shell", "Field", "Base")).toBe(2)
		expect(Inventory.remove(data, "aegis_shell", "Field", "Base", 2)).toBe(true)
		expect(data.stacks["aegis_shell:Field:Base"]).toBeNil()
	end)

	it("sums all variants when no variant is given", function()
		local data = SaveData.new()
		Inventory.add(data, "aegis_shell", "Field", "Chromatic", 1)
		Inventory.add(data, "aegis_shell", "Field", "Base", 2)
		Inventory.add(data, "aegis_shell", "BlackSite", "Base", 7)
		expect(Inventory.count(data, "aegis_shell", "Field")).toBe(3)
	end)

	it("knows whether a card is owned at any tier", function()
		local data = SaveData.new()
		expect(Inventory.ownsCard(data, "aegis_shell")).toBe(false)
		Inventory.add(data, "aegis_shell", "Prototype", "Redacted", 1)
		expect(Inventory.ownsCard(data, "aegis_shell")).toBe(true)
	end)
end)

describe("Inventory serials", function()
	local data: any
	local key = Inventory.key("phase_dash", "Field", "Base")
	local function fresh()
		data = { stacks = {}, serials = {} }
	end

	it("numbers waiting copies and reports the lowest", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 5)
		expect(Inventory.waiting(data, key)).toBe(5)
		expect(Inventory.lowest(data, key)).toBe(nil)
		expect(Inventory.number(data, key, 120, 122)).toBe(3)
		expect(Inventory.waiting(data, key)).toBe(2)
		expect(Inventory.lowest(data, key)).toBe(120)
	end)

	it("uses only as many numbers as copies are waiting", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 2)
		expect(Inventory.number(data, key, 10, 19)).toBe(2)
		expect(data.serials[key].runs).toEqual({ 10, 11 })
		expect(Inventory.number(data, key, 20, 29)).toBe(0)
	end)

	it("joins runs that touch and keeps them sorted", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 6)
		Inventory.number(data, key, 30, 31)
		Inventory.number(data, key, 10, 11)
		Inventory.number(data, key, 12, 13)
		expect(data.serials[key].runs).toEqual({ 10, 13, 30, 31 })
	end)

	it("refuses numbers it already holds", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 6)
		Inventory.number(data, key, 10, 12)
		expect(Inventory.number(data, key, 12, 13)).toBe(0)
		expect(data.serials[key].runs).toEqual({ 10, 12 })
	end)

	it("spends starter copies, then waiting ones, then the highest serials", function()
		fresh()
		Inventory.addPlain(data, "phase_dash", "Field", "Base", 1)
		Inventory.add(data, "phase_dash", "Field", "Base", 4)
		Inventory.number(data, key, 7, 9) -- 1 starter, 1 waiting, serials 7 8 9
		expect(Inventory.remove(data, "phase_dash", "Field", "Base", 3)).toBe(true)
		expect(data.serials[key].plain).toBe(0)
		expect(Inventory.waiting(data, key)).toBe(0)
		expect(data.serials[key].runs).toEqual({ 7, 8 })
		expect(Inventory.count(data, "phase_dash", "Field", "Base")).toBe(2)
	end)

	it("changes nothing when asked to spend more than there is", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 2)
		Inventory.number(data, key, 1, 2)
		expect(Inventory.remove(data, "phase_dash", "Field", "Base", 3)).toBe(false)
		expect(data.serials[key].runs).toEqual({ 1, 2 })
	end)

	it("takes one serial out of the middle of a run", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 5)
		Inventory.number(data, key, 1, 5)
		expect(Inventory.take(data, key, 3)).toBe(true)
		expect(data.serials[key].runs).toEqual({ 1, 2, 4, 5 })
		expect(Inventory.count(data, "phase_dash", "Field", "Base")).toBe(4)
		expect(Inventory.take(data, key, 3)).toBe(false)
		expect(Inventory.take(data, key, 1)).toBe(true)
		expect(Inventory.take(data, key, 5)).toBe(true)
		expect(data.serials[key].runs).toEqual({ 2, 2, 4, 4 })
	end)

	it("clears a stack's record when the last copy goes", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 1)
		Inventory.number(data, key, 4, 4)
		Inventory.remove(data, "phase_dash", "Field", "Base", 1)
		expect(data.stacks[key]).toBe(nil)
		expect(data.serials[key]).toBe(nil)
	end)

	it("never numbers starter copies", function()
		fresh()
		Inventory.addPlain(data, "phase_dash", "Field", "Base", 3)
		expect(Inventory.waiting(data, key)).toBe(0)
		expect(Inventory.number(data, key, 1, 3)).toBe(0)
		expect(Inventory.lowest(data, key)).toBe(nil)
	end)

	it("handles a million copies without visiting each one", function()
		fresh()
		Inventory.add(data, "phase_dash", "Field", "Base", 1000000)
		local started = os.clock()
		expect(Inventory.number(data, key, 1, 1000000)).toBe(1000000)
		expect(Inventory.remove(data, "phase_dash", "Field", "Base", 999990)).toBe(true)
		expect(data.serials[key].runs).toEqual({ 1, 10 })
		expect(os.clock() - started < 0.05).toBe(true)
	end)

	it("works on a save with no serials table yet", function()
		local old: any = { stacks = {} }
		Inventory.add(old, "phase_dash", "Field", "Base", 1)
		expect(Inventory.waiting(old, key)).toBe(1)
		expect(Inventory.number(old, key, 9, 9)).toBe(1)
		expect(Inventory.lowest(old, key)).toBe(9)
	end)
end)

describe("Inventory.give", function()
	local key = Inventory.key("phase_dash", "Field", "Base")

	it("puts one numbered copy back, joining the runs round it", function()
		local data: any = { stacks = {}, serials = {} }
		Inventory.add(data, "phase_dash", "Field", "Base", 5)
		Inventory.number(data, key, 1, 5)
		Inventory.take(data, key, 3)
		expect(Inventory.give(data, key, 3)).toBe(true)
		expect(data.serials[key].runs).toEqual({ 1, 5 })
		expect(data.stacks[key]).toBe(5)
		expect(Inventory.give(data, key, 3)).toBe(false)
		expect(data.stacks[key]).toBe(5)
	end)

	it("starts a stack that isn't there, and leaves waiting copies waiting", function()
		local data: any = { stacks = {}, serials = {} }
		expect(Inventory.give(data, key, 9)).toBe(true)
		expect(data.stacks[key]).toBe(1)
		expect(data.serials[key].runs).toEqual({ 9, 9 })
		Inventory.add(data, "phase_dash", "Field", "Base", 2)
		expect(Inventory.give(data, key, 4)).toBe(true)
		expect(Inventory.waiting(data, key)).toBe(2)
		expect(data.serials[key].runs).toEqual({ 4, 4, 9, 9 })
	end)

	it("refuses a full stack", function()
		local data: any = { stacks = { [key] = Config.MaxStackCount }, serials = {} }
		expect(Inventory.give(data, key, 5)).toBe(false)
		expect(data.stacks[key]).toBe(Config.MaxStackCount)
	end)
end)
