local harness = require("./harness")
local CardHand = require("../src/shared/CardCore/CardHand")

local describe, it, expect = harness.describe, harness.it, harness.expect

describe("CardHand.press", function()
	it("pulls out a ready card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		expect(hand.slot).toBe(2)
	end)

	it("leaves a card on cooldown alone", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, false)
		expect(hand.slot).toBeNil()
	end)

	it("puts the card away on a second press", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		CardHand.press(hand, 2, true)
		expect(hand.slot).toBeNil()
	end)

	it("swaps to another ready card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.press(hand, 3, true)
		expect(hand.slot).toBe(3)
	end)

	it("keeps the held card when the other one isn't ready", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.press(hand, 3, false)
		expect(hand.slot).toBe(1)
	end)
end)

describe("CardHand.click", function()
	it("uses the held card and empties the hand", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		expect(CardHand.click(hand)).toBe(2)
		expect(hand.slot).toBeNil()
	end)

	it("does nothing with an empty hand", function()
		expect(CardHand.click(CardHand.new())).toBeNil()
	end)
end)

describe("CardHand.blocksFire", function()
	it("lets the gun fire with an empty hand", function()
		expect(CardHand.blocksFire(CardHand.new(), true)).toBe(false)
	end)

	it("stops the gun while a card is out", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		expect(CardHand.blocksFire(hand, true)).toBe(true)
		expect(CardHand.blocksFire(hand, false)).toBe(true)
	end)

	it("holds the gun back until the click that used a card is let go", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.click(hand)
		expect(CardHand.blocksFire(hand, true)).toBe(true)
		expect(CardHand.blocksFire(hand, false)).toBe(false)
		expect(CardHand.blocksFire(hand, true)).toBe(false)
	end)
end)

describe("CardHand.putAway", function()
	it("empties the hand without using the card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.putAway(hand)
		expect(hand.slot).toBeNil()
		expect(CardHand.blocksFire(hand, true)).toBe(false)
	end)
end)
