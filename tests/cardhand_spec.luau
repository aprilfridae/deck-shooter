local harness = require("./harness")
local CardHand = require("../src/shared/CardCore/CardHand")

local describe, it, expect = harness.describe, harness.it, harness.expect

describe("CardHand.press", function()
	it("pulls out a ready card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		expect(hand.slot).toBe(2)
	end)

	it("leaves a card on cooldown alone", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, false)
		expect(hand.slot).toBeNil()
	end)

	it("uses the card on a second press of its key", function()
		local hand = CardHand.new()
		expect(CardHand.press(hand, 2, true)).toBeNil()
		expect(CardHand.press(hand, 2, true)).toBe(2)
		expect(hand.slot).toBeNil()
		expect(hand.used).toBe(1)
		expect(hand.turns).toBe(0)
	end)

	it("remembers which card was used last", function()
		local hand = CardHand.new()
		expect(hand.lastUsed).toBeNil()
		CardHand.press(hand, 3, true)
		CardHand.click(hand)
		expect(hand.lastUsed).toBe(3)
	end)

	it("uses nothing when swapping to another card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		expect(CardHand.press(hand, 3, true)).toBeNil()
		expect(hand.slot).toBe(3)
		expect(hand.used).toBe(0)
	end)

	it("swaps to another ready card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.press(hand, 3, true)
		expect(hand.slot).toBe(3)
	end)

	it("keeps the held card when the other one isn't ready", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.press(hand, 3, false)
		expect(hand.slot).toBe(1)
	end)
end)

describe("CardHand.open", function()
	it("pulls out the first ready card", function()
		local hand = CardHand.new()
		CardHand.open(hand, { false, true, true })
		expect(hand.slot).toBe(2)
	end)

	it("uses the held card when the cards key is pressed again", function()
		local hand = CardHand.new()
		expect(CardHand.open(hand, { true, true, true })).toBeNil()
		CardHand.cycle(hand, { true, true, true })
		expect(CardHand.open(hand, { true, true, true })).toBe(2)
		expect(hand.slot).toBeNil()
		expect(hand.used).toBe(1)
	end)

	it("pulls nothing out when no card is ready", function()
		local hand = CardHand.new()
		CardHand.open(hand, { false, false, false })
		expect(hand.slot).toBeNil()
	end)
end)

describe("CardHand.cycle", function()
	it("goes round the ready cards and counts each turn", function()
		local hand = CardHand.new()
		CardHand.open(hand, { true, true, true })
		CardHand.cycle(hand, { true, true, true })
		expect(hand.slot).toBe(2)
		CardHand.cycle(hand, { true, true, true })
		CardHand.cycle(hand, { true, true, true })
		expect(hand.slot).toBe(1)
		expect(hand.turns).toBe(3)
	end)

	it("skips cards on cooldown", function()
		local hand = CardHand.new()
		CardHand.open(hand, { true, false, true })
		CardHand.cycle(hand, { true, false, true })
		expect(hand.slot).toBe(3)
	end)

	it("stays put with no other card ready or no card out", function()
		local hand = CardHand.new()
		CardHand.cycle(hand, { true, true, true })
		expect(hand.slot).toBeNil()
		CardHand.open(hand, { true, false, false })
		CardHand.cycle(hand, { true, false, false })
		expect(hand.slot).toBe(1)
		expect(hand.turns).toBe(0)
	end)
end)

describe("CardHand.click", function()
	it("uses the held card and empties the hand", function()
		local hand = CardHand.new()
		CardHand.press(hand, 2, true)
		expect(CardHand.click(hand)).toBe(2)
		expect(hand.slot).toBeNil()
	end)

	it("does nothing with an empty hand", function()
		local hand = CardHand.new()
		expect(CardHand.click(hand)).toBeNil()
		expect(hand.used).toBe(0)
	end)

	it("counts a card as used on a click, not when it's put away", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.putAway(hand)
		expect(hand.used).toBe(0)
		CardHand.press(hand, 2, true)
		CardHand.click(hand)
		expect(hand.used).toBe(1)
	end)
end)

describe("CardHand.blocksFire", function()
	it("lets the gun fire with an empty hand", function()
		expect(CardHand.blocksFire(CardHand.new(), true)).toBe(false)
	end)

	it("stops the gun while a card is out", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		expect(CardHand.blocksFire(hand, true)).toBe(true)
		expect(CardHand.blocksFire(hand, false)).toBe(true)
	end)

	it("holds the gun back until the click that used a card is let go", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.click(hand)
		expect(CardHand.blocksFire(hand, true)).toBe(true)
		expect(CardHand.blocksFire(hand, false)).toBe(false)
		expect(CardHand.blocksFire(hand, true)).toBe(false)
	end)
end)

describe("CardHand.putAway", function()
	it("empties the hand without using the card", function()
		local hand = CardHand.new()
		CardHand.press(hand, 1, true)
		CardHand.putAway(hand)
		expect(hand.slot).toBeNil()
		expect(CardHand.blocksFire(hand, true)).toBe(false)
	end)
end)
